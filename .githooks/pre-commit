#!/bin/sh
# woynich-wiki: block secrets and invalid records. Works for the blueprint and for instance repositories
# (the instance points core.hooksPath here), using the blueprint's virtualenv.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$ROOT/.venv/Scripts/python.exe" ]; then PY="$ROOT/.venv/Scripts/python.exe"
elif [ -x "$ROOT/.venv/bin/python" ]; then PY="$ROOT/.venv/bin/python"
else PY=python; fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m kb.core.precommit
